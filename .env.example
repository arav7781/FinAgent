# ─── Required ─────────────────────────────────────────────────────────────────
# Groq API key. Every agent call goes through this.  https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# ─── Optional: vector retrieval ───────────────────────────────────────────────
# Leave unset to run without a vector database. Document text is then held in
# process memory and passed to the agent directly — the pipeline still works.
QDRANT_URL=
QDRANT_API_KEY=

# ─── Optional: live market data ───────────────────────────────────────────────
# RapidAPI "Real-Time Finance Data". Without it the News Reporter falls back to
# model knowledge and /api/finance-news/headlines returns an empty list.
RAPIDAPI_KEY=

# ─── Optional: company registry verification ──────────────────────────────────
# Without MCA_API_KEY the deterministic sandbox provider is used, so the
# verification flow stays demonstrable offline.
MCA_API_KEY=
MCA_API_URL=https://api.karza.in/v3/company-master

# ─── Optional: model and server ───────────────────────────────────────────────
LLM_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HOST=0.0.0.0
PORT=7860
LOG_LEVEL=INFO
